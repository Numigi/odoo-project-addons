<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_project_worksheet" model="ir.module.category">
        <field name="name">Worksheets</field>
        <field name="description">Helps you manage your project worksheets.</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_project_worksheet_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="project_worksheet.module_category_project_worksheet"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_project_worksheet_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="project_worksheet.module_category_project_worksheet"/>
        <field name="implied_ids" eval="[(4, ref('project_worksheet.group_project_worksheet_user'))]"/>
    </record>

    <data noupdate="1">
        <record id="project_worksheet_company_rule" model="ir.rule">
            <field name="name">Project Worksheet multi-company</field>
            <field name="model_id" ref="model_project_worksheet"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="project_worksheet_line_company_rule" model="ir.rule">
            <field name="name">Project Worksheet Line multi-company</field>
            <field name="model_id" ref="model_project_worksheet_line"/>
            <field name="domain_force">['|', ('worksheet_id.company_id', '=', False), ('worksheet_id.company_id', 'in', company_ids)]</field>
        </record>

        <record id="project_worksheet_supervisor_rule" model="ir.rule">
            <field name="name">Worksheet: Supervisor Visibility</field>
            <field name="model_id" ref="model_project_worksheet"/>
            <field name="domain_force">
                ['|',
                    ('supervisor_id.user_id', '=', user.id),
                    ('supervisor_id.parent_id.user_id', '=', user.id)
                ]
            </field>
            <field name="groups" eval="[(4, ref('project_worksheet.group_project_worksheet_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
        </record>


        <!-- Rule for Managers: See all worksheets -->
        <record id="project_worksheet_manager_rule" model="ir.rule">
            <field name="name">Worksheet: Manager Visibility</field>
            <field name="model_id" ref="model_project_worksheet"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('project_worksheet.group_project_worksheet_manager'))]"/>
        </record>

       <record id="project_worksheet_timesheet_user_rule" model="ir.rule">
            <field name="name">Worksheet Timesheet: Supervisor Visibility</field>
            <field name="model_id" ref="analytic.model_account_analytic_line"/>
            <field name="domain_force">
                ['|',
                    ('user_id', '=', user.id),
                    ('worksheet_id.supervisor_id.user_id', '=', user.id)
                ]
            </field>
            <field name="groups" eval="[(4, ref('project_worksheet.group_project_worksheet_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>