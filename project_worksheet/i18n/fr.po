#. module: project_worksheet
#: model:mail.template,body_html:project_worksheet.email_template_worksheet_approval
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px; color: #444444;\">\n"
"    <p style=\"margin: 0px 0px 16px 0px;\">\n"
"        Hello ${object.partner_approver_id.name or 'Client'},\n"
"    </p>\n"
"    <p style=\"margin: 0px 0px 16px 0px;\">\n"
"        The installation hours performed on your site on ${object.date_start} are ready for approval. The details can be found in the attached worksheet.\n"
"    </p>\n"
"\n"
"    <table border=\"0\" cellpadding=\"4\" cellspacing=\"0\" style=\"margin-top: 16px; margin-bottom: 24px; width: 100%; max-width: 400px;\">\n"
"        <tr>\n"
"            <td style=\"color: #888888; width: 120px;\">Worksheet</td>\n"
"            <td><strong>${object.name}</strong></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"color: #888888;\">Project</td>\n"
"            <td>${object.project_id.name}</td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"color: #888888;\">Supervisor</td>\n"
"            <td>${object.supervisor_id.name}</td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"color: #888888;\">Total Hours</td>\n"
"            <td><strong>${object.total_hours}</strong></td>\n"
"        </tr>\n"
"    </table>\n"
"\n"
"    <div style=\"margin: 24px 0px 24px 0px;\">\n"
"        <a href=\"${object.get_base_url()}/my/worksheet/${object.id}/${object.access_token}\" target=\"_blank\" style=\"background-color: #F89406; padding: 10px 20px; text-decoration: none; color: #ffffff; border-radius: 3px; font-size: 14px; font-weight: bold;\">\n"
"            Review and approve the worksheet\n"
"        </a>\n"
"    </div>\n"
"\n"
"    <p style=\"color: #888888; font-size: 11px; margin-top: 32px;\">\n"
"        This link is personal and remains valid for 14 days. The approval only covers the installation hours performed on site.\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px; color: #444444;\">\n"
"    <p style=\"margin: 0px 0px 16px 0px;\">\n"
"        Bonjour ${object.partner_approver_id.name or 'Client'},\n"
"    </p>\n"
"    <p style=\"margin: 0px 0px 16px 0px;\">\n"
"        Les heures d'installation effectuées sur votre site le ${object.date_start} sont prêtes pour approbation. Les détails se trouvent dans la feuille de chantier en pièce jointe.\n"
"    </p>\n"
"\n"
"    <table border=\"0\" cellpadding=\"4\" cellspacing=\"0\" style=\"margin-top: 16px; margin-bottom: 24px; width: 100%; max-width: 400px;\">\n"
"        <tr>\n"
"            <td style=\"color: #888888; width: 120px;\">Feuille de chantier</td>\n"
"            <td><strong>${object.name}</strong></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"color: #888888;\">Projet</td>\n"
"            <td>${object.project_id.name}</td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"color: #888888;\">Superviseur</td>\n"
"            <td>${object.supervisor_id.name}</td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"color: #888888;\">Heures totales</td>\n"
"            <td><strong>${object.total_hours}</strong></td>\n"
"        </tr>\n"
"    </table>\n"
"\n"
"    <div style=\"margin: 24px 0px 24px 0px;\">\n"
"        <a href=\"${object.get_base_url()}/my/worksheet/${object.id}/${object.access_token}\" target=\"_blank\" style=\"background-color: #F89406; padding: 10px 20px; text-decoration: none; color: #ffffff; border-radius: 3px; font-size: 14px; font-weight: bold;\">\n"
"            Examiner et approuver la feuille de chantier\n"
"        </a>\n"
"    </div>\n"
"\n"
"    <p style=\"color: #888888; font-size: 11px; margin-top: 32px;\">\n"
"        Ce lien est personnel et reste valide pendant 14 jours. L'approbation couvre uniquement les heures d'installation effectuées sur site.\n"
"    </p>\n"
"</div>\n"
"            "

