<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_worksheet_complement_view_form" model="ir.ui.view">
        <field name="name">project.worksheet.complement.form</field>
        <field name="model">project.worksheet.complement</field>
        <field name="arch" type="xml">
            <form string="Feuille complémentaire">
                <group>
                    <field name="worksheet_id" readonly="1"/>
                </group>
                <footer>
                    <button name="action_create_complement" string="Générer" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_project_worksheet_complement" model="ir.actions.act_window">
        <field name="name">Créer une feuille complémentaire</field>
        <field name="res_model">project.worksheet.complement</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>