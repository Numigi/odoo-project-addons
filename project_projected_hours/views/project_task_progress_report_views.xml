<?xml version='1.0' encoding='UTF-8'?>
<odoo>       
        <record id="view_task_project_progress_tree" model="ir.ui.view">
            <field name="name">report.project.task.progress.tree</field>
            <field name="model">project.task</field>
            <field name="arch" type="xml">
                <tree string="Tasks Progress" create="false" default_order="id desc">
                    <field name="project_id" />   
                    <field name="name" string="Task" />                  
                    <field name="planned_hours" widget="timesheet_uom_no_toggle" optional="show" />
                    <field name="effective_hours" widget="timesheet_uom_no_toggle" optional="show" />
                    <field name="remaining_hours" widget="timesheet_uom_no_toggle" optional="show" />
                    <field name="projected_hours" widget="timesheet_uom_no_toggle" optional="show" />
                    <field name="progress" widget="progressbar" string="Progress (%)" optional="show" />
                    <field name="real_progress" widget="progressbar" string="Real Progress (%)" optional="show" />
                </tree>
            </field>
        </record>

        <record id="action_project_task_progress_tree" model="ir.actions.act_window">
            <field name="name">Tasks Progress</field>
            <field name="res_model">project.task</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_task_project_progress_tree" />
        </record>

        <menuitem id="menu_project_report_task_progress" name="Tasks Progress" action="project_projected_hours.action_project_task_progress_tree" parent="project.menu_project_report" groups="project.group_project_manager" sequence="30" />


</odoo>