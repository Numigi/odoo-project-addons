<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Form View -->
    <record id="project_milestone_active_view_form" model="ir.ui.view">
        <field name="name">Project Milestone Active Form</field>
        <field name="model">project.milestone</field>
        <field name="inherit_id" ref="project.project_milestone_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                    <field name="active" invisible="1"/>
                    <button name="toggle_active" string="Archive" type="object" attrs="{'invisible': [('active', '=', False)]}"
                            icon="fa-archive"/>
                    <button name="toggle_active" type="object"
                            class="oe_stat_button"
                            string="Unarchive"
                            icon="fa-archive"
                            attrs="{'invisible': [('active', '=', True)]}" >
                    </button>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="project_id"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page name="tasks" string="Tasks">
                        <field name="task_ids" context="{'default_project_id': project_id, 'default_date_end': deadline, 'default_milestone_id': active_id}"/>
                    </page>
                </notebook>
            </xpath>
            <xpath expr="//field[@name='is_reached']" position="after">
                <field name="progress" widget="progressbar"/>
            </xpath>
            <xpath expr="//sheet" position="after">
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </xpath>
        </field>
    </record>

    <!-- Sequences-->
    <record id="project_milestone_seq" model="ir.sequence">
        <field name="name">Project Milestone Sequence</field>
        <field name="code">project.milestone</field>
        <field name="prefix">0</field>
        <field name="padding">1</field>
    </record>

    <!-- List View-->
    <record id="project_milestone_view_list" model="ir.ui.view">
        <field name="name">Project Milestone List</field>
        <field name="model">project.milestone</field>
        <field name="arch" type="xml">
            <tree default_order='sequence'>
                <field name="sequence"
                       widget="handle"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="deadline"/>
                <field name="task_ids"/>
                <field name="progress"
                       widget="progressbar"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="project_milestone_view_search" model="ir.ui.view">
        <field name="name">Project Milestone Search</field>
        <field name="model">project.milestone</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <group expand="1" string="Group By">
                    <filter string="Project"
                            name="group_by_project"
                            context="{'group_by':'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- actions opening views on models -->
    <record id="project_milestone_action" model="ir.actions.act_window">
        <field name="name">Project Milestones</field>
        <field name="res_model">project.milestone</field>
        <field name="context">{'group_by': 'project_id'}</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Items -->
    <menuitem
        name="All Milestones"
        id="milestone_configuration_menu"
        parent="project.menu_project_config"
        sequence="19"
        action="project_milestone_action"/>
</odoo>
