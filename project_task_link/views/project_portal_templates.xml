<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="portal_my_task" inherit_id="project.portal_my_task" name="Replace task description with description_portal">
        <xpath expr="//div[@t-field='task.description']" position="replace">
             <div class="py-1 px-2 bg-100 small table-responsive" t-field="task.description_portal"/>
        </xpath>
    </template>
</odoo>