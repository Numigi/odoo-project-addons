<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="task_parent_id_domain" model="ir.ui.view">
        <field name="name">Task Parent ID with Domain</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//group/field[@name='parent_id']" position="attributes">
                <attribute name="domain">[('project_id', '=', project_id), ('id', '!=', id)]</attribute>
            </xpath>
        </field>
    </record>

</odoo>
