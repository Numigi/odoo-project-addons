<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="portal_my_task" inherit_id="hr_timesheet.portal_my_task" priority="100">
        <!-- Hide print/download button -->
        <xpath expr="//div[@id='nav-report']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <!-- Hide timesheets navigation link -->
        <xpath expr="//div[hasclass('nav-item')]/a[@href='#task_timesheets']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <!-- Hide timesheets content section -->
        <xpath expr="//div[hasclass('container')]/h5[@id='task_timesheets']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <!-- Hide timesheet table -->
        <xpath expr="//div[hasclass('container')][@t-if='timesheets and allow_timesheets']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <!-- Hide progress display -->
        <xpath expr="//div[@t-if='task.allocated_hours > 0 and allow_timesheets']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <!-- Hide allocated hours field -->
        <xpath expr="//div[@name='portal_my_task_allocated_hours']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>

    <!-- Disable templates that add timesheet columns and menu -->
    <record id="hr_timesheet.portal_tasks_list_inherit" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

    <record id="hr_timesheet.portal_my_home_timesheet" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

</odoo>
