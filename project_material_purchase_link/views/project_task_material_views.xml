<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="task_material_list_view_inherit" model="ir.ui.view">
        <field name="name">Task Material List Inherit</field>
        <field name="model">project.task.material</field>
        <field name="inherit_id" ref="project_material.task_material_list_view"/>
        <field name="arch" type="xml">
            <field name="unit_cost" position="before">
                <field name="purchase_id" string="Related Document" optional="show"/>
            </field>
        </field>
    </record>

    <record id="task_material_form_view_inherit" model="ir.ui.view">
        <field name="name">Task Material Form Inherit</field>
        <field name="model">project.task.material</field>
        <field name="inherit_id" ref="project_material.task_material_form_view"/>
        <field name="arch" type="xml">
            <field name="product_id" position="before">
                <field name="purchase_id" string="Related Document"/>
            </field>
        </field>
    </record>
    
    <record id="task_material_search_inherit" model="ir.ui.view">
        <field name="name">Task Material Search Inherit</field>
        <field name="model">project.task.material</field>
        <field name="inherit_id" ref="project_material.task_material_search"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="purchase_id" string="Related Document"/>
            </field>
            <filter name="group_by_project_id" position="after">
                <filter string="Related Document" name="group_by_purchase_id" context="{'group_by': 'purchase_id'}"/>
            </filter>
        </field>
    </record>

</odoo>
